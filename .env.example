# Cell AI Voicebot — frontend environment variables
# Copy to `.env.local` for local development (gitignored).
# ⚠️ VITE_* variables browser bundle me PUBLIC hote hain — inme kabhi secret mat daalna.

# API base path. Default goes through the Vite dev proxy (/api → http://localhost:5100).
VITE_API_URL=/api/v1
# Dashboard WebSocket URL (proxied /ws → backend on :5100).
VITE_WS_URL=ws://localhost:3100/ws
VITE_APP_NAME=Cell AI Voicebot
